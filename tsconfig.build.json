{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "vitest.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
